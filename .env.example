# Copia este archivo a .env para desarrollo local. NUNCA subas .env al repo.
# En producción (Railway) estas variables se configuran en el dashboard.

# --- Base de datos (obligatoria) ---
# Cadena de conexión de PostgreSQL. En Railway la inyecta el servicio Postgres.
DATABASE_URL=postgres://usuario:password@localhost:5432/barberia

# --- Servidor ---
# Railway define PORT automáticamente. Por defecto: 3000.
PORT=3000

# --- Negocio inicial "estilo-internacional" (solo se usan al crearlo la primera vez) ---
# Contraseña del panel de admin de Estilo Internacional. Si se omite, se genera una aleatoria.
ADMIN_PASS=
# Nombres de los barberos separados por coma. Por defecto: Pedro,GGTHEBARBER
BARBEROS=
# Correo al que Estilo Internacional recibe avisos de citas (se sincroniza en cada arranque).
# CORREO_ONYX es el nombre anterior y se sigue aceptando.
CORREO_PRINCIPAL=

# --- Panel del dueño del SaaS (/super) ---
# Contraseña del panel /super. Si está vacía, el panel queda inaccesible.
SUPER_PASS=

# --- Avisos por correo (Resend) ---
RESEND_API_KEY=
# Remitente. Por defecto: Avisos de citas <onboarding@resend.dev> (solo pruebas).
MAIL_FROM=
# Opcional: URL de la API de Resend. Por defecto: https://api.resend.com/emails
RESEND_URL=

# --- Avisos por webhook (Make) ---
MAKE_WEBHOOK_URL=

# --- Cobro de suscripciones (billing.js) ---
# Sin estas claves nadie puede pagar en línea; la prueba gratis y la activación manual desde /super siguen funcionando.
# URL pública del sitio, para los enlaces de regreso del pago. Ej: https://tudominio.com
PUBLIC_URL=
# Precio mensual en MXN que se muestra y (en Mercado Pago) se cobra.
PRECIO_BASICO=
PRECIO_PRO=
# Stripe: clave secreta, secreto del webhook (/webhooks/stripe) y el id de precio recurrente de cada plan.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASICO=
STRIPE_PRICE_PRO=
# Mercado Pago: access token y secreto de firma del webhook (/webhooks/mercadopago).
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Solo para pruebas: URLs alternas de las APIs (por defecto las oficiales).
STRIPE_API_URL=
MP_API_URL=

# --- Marketing con IA (marketing.js) ---
# Sin clave el módulo entrega plantillas con los datos de la barbería; con clave usa Claude.
ANTHROPIC_API_KEY=
# Modelo (por defecto claude-sonnet-5-5) y, solo para pruebas, URL alterna de la API.
ANTHROPIC_MODEL=
ANTHROPIC_API_URL=
# Ideas con IA por barbería y mes, según su plan (por defecto 8 prueba, 30 básico, 120 pro).
IA_CUOTA_PRUEBA=
IA_CUOTA_BASICO=
IA_CUOTA_PRO=
